# Supabase Configuration
# Renseignez ces variables avec vos identifiants de projet Supabase
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Google Maps Platform Configuration (Cartes interactives, géolocalisation et tracés des zones)
VITE_GOOGLE_MAPS_API_KEY=AIzaSy...

# Google OAuth / Identity Services (GIS)
# Permet d'afficher la boîte de dialogue Google directe sur clinigo.fr (sans afficher supabase.co)
VITE_GOOGLE_CLIENT_ID=votre-client-id-google.apps.googleusercontent.com

# Resend Email Configuration (Emails transactionnels)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL="Clinigo <bonjour@notifications.clinigo.fr>"

# Twilio Configuration (Vérification du numéro de téléphone par SMS)
# Option A (Recommandé) : Twilio Verify Service
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Option B (Alternative) : Twilio Programmable SMS
# TWILIO_PHONE_NUMBER=+33XXXXXXXXX

# Stripe Configuration (Abonnement Clinigo Pro 19,90 € / mois)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
