<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Endpoints API PHP directs pour Apache / Plesk
  RewriteRule ^api/email/password-reset/?$ /api/email/password-reset/index.php [QSA,L]
  RewriteRule ^api/health/?$ /api/health.php [QSA,L]

  # Routage SPA React Router (ne réécrit pas les fichiers ou dossiers physiques réels)
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Sécurité de base
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # Cache immuable pour les assets hashés (JS, CSS, images, polices)
  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>

  # Pas de cache pour index.html afin d'assurer la réception immédiate des mises à jour
  <FilesMatch "^(index\.html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>
</IfModule>
